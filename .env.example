# Configuración necesaria para PhotoBogota
MONGO_USER=
MONGO_PASS=
JWT_SECRET=

MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Opcional: Cloudinary (subida de imágenes). Si se define, las imágenes se suben
# a Cloudinary (plan gratuito). Si está vacío, se guardan localmente.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Cómo obtenerla: https://console.cloudinary.com/ → Settings → API Keys
CLOUDINARY_URL=
