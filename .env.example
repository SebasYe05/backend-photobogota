# ============================================================
# PhotoBogota Backend — variables de entorno (AWS EC2)
# Copia este archivo como ".env" en la raíz del repo (junto a
# compose.yaml) y ejecuta:
#   docker compose up --build -d
# ============================================================

# --- MongoDB Atlas ---
MONGO_USER=
MONGO_PASS=

# --- JWT ---
JWT_SECRET=

# --- Correo (recuperación / notificaciones) ---
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- CORS: dominios permitidos del frontend (separados por coma) ---
# Local:  http://localhost:5173
# Vercel: https://tu-proyecto.vercel.app
# Incluye uno o varios según dónde vivan tus frontends.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-proyecto.vercel.app

# --- Imágenes: URL pública del backend (IMPORTANTE en EC2) ---
# El backend guarda en la BD la URL de cada imagen. Si esta variable queda
# vacía, usa http://localhost:8080/uploads y las fotos se rompen para todos.
# Esta es la URL pública de tu EC2 (debe estar prendida y con el puerto 8080
# abierto en el Security Group). Formato: {base}/carpeta/uuid_nombre.jpg
STORAGE_LOCAL_URL_BASE=http://AWS:8080/uploads

# Carpeta física de las imágenes dentro del contenedor (default "uploads").
# Si la cambias, ajusta el volumen del compose.yaml.
# APP_UPLOAD_DIR=/uploads

# --- Cloudinary (opcional, recomendado en EC2) ---
# Si DEFINES CLOUDINARY_URL, las imágenes se suben a Cloudinary y devuelven
# URLs HTTPS absolutas (CDN, nada de almacenamiento local; puedes ignorar
# STORAGE_LOCAL_URL_BASE). Si queda vacío, se usa almacenamiento local.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Cómo obtenerla: https://console.cloudinary.com/ → Settings → API Keys
CLOUDINARY_URL=